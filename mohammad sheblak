using System;

namespace StudentRecord
{
    public class Student
    {
        private string name;
        private int id;
        private double gpa;

        public string Name
        {
            get { return name; }
            set { name = value; }
        }

        public int Id
        {
            get { return id; }
            set { id = value; }
        }

        public double Gpa
        {
            get { return gpa; }
            set
            {
                if (value >= 0.0 && value <= 4.0)
                {
                    gpa = value;
                }
                else
                {
                    Console.WriteLine($"\n[VALIDATION ERROR] Attempted to set an invalid GPA: {value}.");
                    Console.WriteLine("GPA must be between 0.0 and 4.0. GPA remains unchanged.");
                }
            }
        }

        public void DisplayRecord()
        {
            Console.WriteLine("\n--- Student Record ---");
            Console.WriteLine($"Name: {Name}");
            Console.WriteLine($"ID: {Id}");
            Console.WriteLine($"GPA: {Gpa:F2}");
            Console.WriteLine("----------------------");
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Student Record Project initialized.");

            Student student1 = new Student();
            student1.Name = "Alice Johnson";
            student1.Id = 1001;
            student1.Gpa = 3.5;

            Console.WriteLine("\n--- Testing Student 1 (Valid GPA) ---");
            student1.DisplayRecord();

            Student student2 = new Student();
            student2.Name = "Bob Smith";
            student2.Id = 1002;
            
            student2.Gpa = 2.0; 
            student2.DisplayRecord();

            Console.WriteLine("\n--- Attempting to set an INVALID GPA for Student 2 (5.0) ---");
            student2.Gpa = 5.0;
            
            student2.DisplayRecord();

            Console.WriteLine("\n--- Attempting to set another INVALID GPA for Student 2 (-1.0) ---");
            student2.Gpa = -1.0;
            
            student2.DisplayRecord();
        }
    }
}
